# =============================================================================
# TAM TRÍ LỰC — Enterprise Configuration
# =============================================================================
# Chỉ cần sửa các giá trị trong file này, mọi thứ tự động chạy.
# Local: giữ nguyên mặc định → chạy ngay với "docker compose up -d"
# Production: sửa DOMAIN + mật khẩu DB mạnh → chạy "bash scripts/setup-prod.sh"
# =============================================================================

# ─────────── DOMAIN ───────────
# Local: giữ localhost
# Production: điền domain thật (VD: example.com)
DOMAIN=vnsales.org
API_DOMAIN=api.vnsales.org

# ─────────── DOCKER HUB ───────────
# Tài khoản Docker Hub để push/pull image (build local, pull trên VPS)
DOCKER_USER=tboi0602
IMAGE_TAG=latest

# ─────────── POSTGRESQL ───────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ttl
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/ttl

# ─────────── JWT ───────────
# WARNING: Đây là key bảo mật quan trọng nhất! Dùng chuỗi 64 ký tự ngẫu nhiên.
JWT_SECRET=sos-jwt-secret-key-2026

# ─────────── API SERVER ───────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─────────── RESEND (Email) ───────────
#  Resend test mode: chỉ gửi được đến email đã đăng ký tài khoản Resend
# Khi có domain thật, verify trong Resend dashboard rồi đổi lại
RESEND_API_KEY=re_VBMnNnLZ_9NUsRHbUJh5SMgAVbAvsFxit
EMAIL_FROM="SOS <onboarding@vnsales.org>"

# ─────────── GOOGLE ───────────
GOOGLE_CLIENT_ID=120854701018-7mcrrh24bsv6g0btgnnh0a7ajbeb92pr.apps.googleusercontent.com

# ─────────── GEMINI AI ───────────
GEMINI_API_KEY=AIzaSyAOS5yF84yaWjnPalDwJczgmHTbLZihbZ4

# ─────────── WEBSITE ───────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=120854701018-7mcrrh24bsv6g0btgnnh0a7ajbeb92pr.apps.googleusercontent.com
