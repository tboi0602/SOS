# =============================================================================
# TAM TRÍ LỰC — Environment Template
# =============================================================================
# Sao chép file này thành .env (local) hoặc .env.docker (Docker),
# điền giá trị phù hợp.
# =============================================================================

# ─────────── DOMAIN ───────────
DOMAIN=localhost
API_DOMAIN=api.localhost

# ─────────── DOCKER HUB ───────────
DOCKER_USER=your_dockerhub_user
IMAGE_TAG=latest

# ─────────── POSTGRESQL ───────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ttl
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/ttl

# ─────────── JWT ───────────
JWT_SECRET=your_jwt_secret_key

# ─────────── API SERVER ───────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─────────── RESEND (Email) ───────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM="Tinh Hoa Việt <noreply@example.com>"

# ─────────── GOOGLE ───────────
GOOGLE_CLIENT_ID=your_google_client_id

# ─────────── GEMINI AI ───────────
GEMINI_API_KEY=your_gemini_api_key

# ─────────── VPS DEPLOY ───────────
# Cấu hình SSH để deploy script tự động đẩy lên VPS
# Nếu bỏ trống SSH_HOST, script sẽ chỉ build + push, không deploy từ xa
SSH_HOST=
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
# Thư mục chứa docker-compose.yml + .env trên VPS
VPS_PROJECT_DIR=/root/tamtriluc

# ─────────── TBV OIDC SSO ───────────
TBV_OIDC_ISSUER=https://api.congacf.com/oidc
TBV_OIDC_CLIENT_ID=your_tbv_client_id
TBV_OIDC_CLIENT_SECRET=your_tbv_client_secret
TBV_OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback

# ─────────── WEBSITE ───────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
